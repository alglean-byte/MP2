import java.util.Scanner;

class Guest {

    private String guestId;
    private String name;

    public Guest(String guestId, String name) {
        this.guestId = guestId;
        this.name = name;
    }

    public String getGuestId() {
        return guestId;
    }

    public String getName() {
        return name;
    }
}

class Room {

    private int roomNumber;
    private String roomType;
    private double nightlyRate;
    private boolean available;

    public Room(int roomNumber, String roomType, double nightlyRate) {
        this.roomNumber = roomNumber;
        this.roomType = roomType;
        this.nightlyRate = nightlyRate;
        this.available = true;
    }

    public int getRoomNumber() {
        return roomNumber;
    }

    public String getRoomType() {
        return roomType;
    }

    public double getNightlyRate() {
        return nightlyRate;
    }

    public boolean isAvailable() {
        return available;
    }

    public boolean reserve() {

        if (!available) {
            return false;
        }

        available = false;
        return true;
    }

    public void release() {
        available = true;
    }
}

class Reservation {

    private String reservationId;
    private Guest guest;
    private Room room;
    private int nights;

    public Reservation(
        String reservationId,
        Guest guest,
        Room room,
        int nights
    ) {
        this.reservationId = reservationId;
        this.guest = guest;
        this.room = room;
        this.nights = nights;
    }

    public double getTotalCost() {
        return room.getNightlyRate() * nights;
    }

    public void displayReservation() {

        System.out.println(
            reservationId + " | " +
            guest.getGuestId() + " | " +
            guest.getName() + " | Room " +
            room.getRoomNumber() + " | " +
            nights + " nights | PHP " +
            getTotalCost()
        );
    }
}

public class Main {

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

     

        System.out.print("Number of rooms: ");
        int roomCount = input.nextInt();
        input.nextLine();

        Room[] rooms = new Room[roomCount];

        for (int i = 0; i < roomCount; i++) {

            System.out.println("\nRoom " + (i + 1));

            System.out.print("Room Number: ");
            int roomNumber = input.nextInt();
            input.nextLine();

            System.out.print("Room Type: ");
            String roomType = input.nextLine();

            System.out.print("Nightly Rate: ");
            double rate = input.nextDouble();
            input.nextLine();

            rooms[i] = new Room(roomNumber, roomType, rate);
        }


        System.out.print("\nNumber of guests: ");
        int guestCount = input.nextInt();
        input.nextLine();

        Guest[] guests = new Guest[guestCount];

        for (int i = 0; i < guestCount; i++) {

            System.out.println("\nGuest " + (i + 1));

            System.out.print("Guest ID: ");
            String id = input.nextLine();

            System.out.print("Full Name: ");
            String name = input.nextLine();

            guests[i] = new Guest(id, name);
        }

     

        System.out.print("\nNumber of reservation requests: ");
        int requestCount = input.nextInt();
        input.nextLine();

        Reservation[] reservations = new Reservation[requestCount];

        int reservationCount = 0;
        double totalRevenue = 0;

        for (int i = 0; i < requestCount; i++) {

            System.out.println("\nReservation " + (i + 1));

            System.out.print("Reservation ID: ");
            String reservationId = input.nextLine();

            System.out.print("Guest ID: ");
            String guestId = input.nextLine();

            System.out.print("Room Number: ");
            int roomNumber = input.nextInt();

            System.out.print("Number of nights: ");
            int nights = input.nextInt();
            input.nextLine();

          
            Guest foundGuest = null;

            for (int j = 0; j < guests.length; j++) {

                if (guests[j].getGuestId().equals(guestId)) {
                    foundGuest = guests[j];
                    break;
                }
            }

          
            Room foundRoom = null;

            for (int j = 0; j < rooms.length; j++) {

                if (rooms[j].getRoomNumber() == roomNumber) {
                    foundRoom = rooms[j];
                    break;
                }
            }

           
            if (foundGuest == null) {

                System.out.println("Reservation rejected: Guest not found.");

            }
            else if (foundRoom == null) {

                System.out.println("Reservation rejected: Room not found.");

            }
            else if (nights < 1) {

                System.out.println("Reservation rejected: Nights must be at least 1.");

            }
            else if (!foundRoom.reserve()) {

                System.out.println("Reservation rejected: Room is unavailable.");

            }
            else {

                Reservation reservation =
                    new Reservation(
                        reservationId,
                        foundGuest,
                        foundRoom,
                        nights
                    );

                reservations[reservationCount] = reservation;
                reservationCount++;

                totalRevenue += reservation.getTotalCost();

                System.out.println("Reservation accepted.");
                System.out.printf(
                    "Total cost: PHP %.2f%n",
                    reservation.getTotalCost()
                );
            }
        }

       

        System.out.println("\n===== RESERVATION SUMMARY =====");

        for (int i = 0; i < reservationCount; i++) {
            reservations[i].displayReservation();
        }

        System.out.printf(
            "\nTotal expected revenue: PHP %.2f%n",
            totalRevenue
        );

       

        System.out.println("\n===== AVAILABLE ROOMS =====");

        for (int i = 0; i < rooms.length; i++) {

            if (rooms[i].isAvailable()) {

                System.out.println(
                    "Room " +
                    rooms[i].getRoomNumber() +
                    " - " +
                    rooms[i].getRoomType()
                );
            }
        }

        input.close();
    }
}
